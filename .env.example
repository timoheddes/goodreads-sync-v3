# Anna's Archive fast-download API key
AA_API_KEY=your_api_key_here

# Host path to mount as /downloads (parent of each user's folder)
DOWNLOADS_PATH=/volume1/books

# Gmail address + app password, used to send daily digest emails.
# Optional -- leave blank to disable email notifications.
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# UID/GID that should own files written to /app/data and /downloads.
# Set these to match the Synology user that owns your books share,
# e.g. run `id <your-nas-user>` over SSH to find them.
PUID=1000
PGID=1000

# Timezone for logs, cron schedules, and the daily digest send time.
TZ=Europe/Amsterdam

# Port the dashboard/health check listens on (host port, since the
# container runs with network_mode: host). Defaults to an obscure high
# port so it's unlikely to collide with anything else on the NAS -- change
# it if this one happens to be taken too.
DASHBOARD_PORT=47291
