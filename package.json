{
  "name": "goodreads-sync-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "DB_PATH=/tmp/goodreads-sync-test.db node --import tsx --test src/**/*.test.ts",
    "user:add": "tsx src/cli/add-user.ts",
    "user:list": "tsx src/cli/list-users.ts",
    "books:requeue": "tsx src/cli/requeue-book.ts",
    "folders:scan": "tsx src/cli/scan-folders.ts",
    "digest:send": "tsx src/cli/send-digest.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^7.4.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.7",
    "better-sqlite3": "^11.3.0",
    "cheerio": "^1.0.0",
    "drizzle-orm": "^0.33.0",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^4.28.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.24",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
